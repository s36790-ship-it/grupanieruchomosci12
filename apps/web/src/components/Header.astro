---
import { firma, uslugi } from '../data/site';
const glowne = uslugi.slice(0, 4);
const sciezka = Astro.url.pathname;
---
<header class="naglowek">
  <div class="kontener naglowek__wnetrze">
    <a class="znak" href="/">
      <span>{firma.nazwa}</span>
      <i aria-hidden="true"></i>
    </a>

    <input type="checkbox" id="menu-przelacznik" class="menu-przelacznik" hidden />
    <label class="menu-guzik" for="menu-przelacznik">
      <span class="pomijalny-tekst">Menu</span>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </label>

    <nav class="menu" aria-label="Nawigacja główna">
      <ul class="menu__lista">
        <li class="menu__grupa">
          <span class="menu__etykieta">Usługi</span>
          <ul class="menu__podlista">
            {glowne.map((u) => (
              <li><a href={`/${u.slug}`} aria-current={sciezka === `/${u.slug}` ? 'page' : undefined}>{u.nazwa}</a></li>
            ))}
          </ul>
        </li>
        <li><a href="/zwiekszamy-wartosc" aria-current={sciezka === '/zwiekszamy-wartosc' ? 'page' : undefined}>Jak zwiększamy wartość</a></li>
        <li><a href="/o-nas" aria-current={sciezka === '/o-nas' ? 'page' : undefined}>O nas</a></li>
        <li><a href="/kontakt" aria-current={sciezka === '/kontakt' ? 'page' : undefined}>Kontakt</a></li>
        <li><a class="przycisk przycisk--maly" href="/kontakt">Porozmawiajmy</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .naglowek { border-bottom: 1px solid var(--linia); background: var(--biel); }
  .naglowek__wnetrze { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 80px; flex-wrap: wrap; }
  .znak { display: flex; flex-direction: column; gap: 3px; text-decoration: none; padding-block: 8px; }
  .znak span { font-family: var(--font-naglowek); font-size: clamp(1.15rem, 2.4vw, 1.5rem); font-weight: 600; color: var(--granat); letter-spacing: -0.01em; }
  .znak i { width: 32px; height: 2px; background: var(--zloto); }
  .przycisk--maly { min-height: 46px; padding: 0 22px; font-size: 16px; }
  .menu__lista { display: flex; align-items: center; gap: 28px; }
  .menu__lista > li > a:not(.przycisk), .menu__etykieta { font-size: 16px; font-weight: 500; color: var(--tekst); text-decoration: none; }
  .menu__lista .przycisk { color: var(--biel); text-decoration: none; }
  .menu__lista .przycisk:hover { color: var(--biel); }
  .menu__lista a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--zloto); text-decoration-thickness: 2px; }
  .menu__grupa { position: relative; }
  .menu__etykieta { display: inline-flex; align-items: center; gap: 6px; cursor: default; }
  .menu__etykieta::after { content: ''; width: 7px; height: 7px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); }
  .menu__podlista { position: absolute; top: 100%; left: -16px; min-width: 250px; background: var(--biel); border: 1px solid var(--linia); padding: 10px 0; display: none; z-index: 20; }
  .menu__grupa:hover .menu__podlista, .menu__grupa:focus-within .menu__podlista { display: block; }
  .menu__podlista a { display: block; padding: 10px 20px; font-size: 16px; text-decoration: none; }
  .menu__podlista a:hover { background: var(--szary-tlo); }
  .menu-guzik { display: none; }
  .pomijalny-tekst { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  @media (max-width: 900px) {
    .menu-guzik { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; color: var(--granat); cursor: pointer; }
    .menu { display: none; width: 100%; padding-bottom: 20px; }
    .menu-przelacznik:checked ~ .menu { display: block; }
    .menu__lista { flex-direction: column; align-items: stretch; gap: 0; }
    .menu__lista > li { border-top: 1px solid var(--linia); }
    .menu__lista > li > a { display: block; padding: 16px 0; }
    .menu__etykieta { display: block; padding: 16px 0 6px; font-size: 14px; color: var(--tekst-drugi); text-transform: uppercase; letter-spacing: 0.04em; }
    .menu__etykieta::after { display: none; }
    .menu__podlista { position: static; display: block; border: 0; padding: 0 0 12px; min-width: 0; }
    .menu__podlista a { padding: 12px 0 12px 16px; border-left: 2px solid var(--linia-mocna); }
    .menu__lista > li:last-child { border-top: 0; padding-top: 16px; }
    .przycisk--maly { width: 100%; min-height: 54px; }
  }
</style>
