---
import Base from '../layouts/Base.astro';
---
<Base title="Nie znaleziono strony — Grupa Nieruchomości" description="Ta strona nie istnieje lub została przeniesiona." noindex={true}>
  <section class="sekcja">
    <div class="kontener" style="max-width: 60ch; display: flex; flex-direction: column; gap: 20px; align-items: flex-start;">
      <h1>Nie znaleźliśmy tej strony</h1>
      <p>Adres mógł się zmienić albo strona jeszcze nie powstała. Wróć na stronę główną lub napisz do nas.</p>
      <a class="przycisk" href="/">Strona główna</a>
    </div>
  </section>
</Base>
