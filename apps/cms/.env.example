# Baza danych.
# macOS + Homebrew (najczęstszy przypadek) — bez nazwy użytkownika i hasła:
DATABASE_URL=postgresql://localhost:5432/gn
# Docker compose z tego repozytorium:  postgresql://gn:gn@localhost:5432/gn
# Neon (produkcja): connection string skopiowany z panelu Neona

# Długi losowy ciąg. Nie commitujemy go.
PAYLOAD_SECRET=

# Adres panelu
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Magazyn plików (produkcja: Cloudflare R2, zgodny z S3)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Klucz, którym strona w Astro pobiera treści po stronie serwera
PAYLOAD_API_KEY=
